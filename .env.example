# Plausible Analytics (privacy-friendly, cookie-free).
# Leave empty/unset to disable analytics entirely — no tracker is loaded.
# Users can additionally opt out at runtime in Settings → Privacy & Analytics.
VITE_PLAUSIBLE_DOMAIN="nostrhub.io"

# Optional. Defaults to Plausible Cloud's endpoint when omitted.
# Set this only when self-hosting Plausible.
# VITE_PLAUSIBLE_ENDPOINT="https://plausible.example.com/api/event"
